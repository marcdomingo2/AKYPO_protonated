echo            screen
variable        dcdfreq index 50000
variable        outputname index production


newton off
package gpu 1 neigh yes

units           real
boundary        p p p


pair_style      lj/cut/coul/long/gpu 10 12
pair_modify     mix geometric
kspace_style    pppm/gpu 1e-4


atom_style      full
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
special_bonds   lj/coul 0.0 0.0 0.5
improper_style  cvff
timestep        2

read_data       10-10AKYPO.data
reset_atoms mol all


neighbor        2 bin
neigh_modify    delay 5 every 1

include         constraint_angletype
fix             1 all shake 1e-6 500 0 m 1.008 a ${constraint_angletype}
fix             2 all nvt temp 294.15 294.15 100.0
fix             removeCOM all momentum 100 linear 1 1 1

velocity         all create 294.15 3456 mom yes dist gaussian loop geom  

thermo          500
thermo_style    custom step time xlo xhi ylo yhi zlo zhi etotal pe ke temp press ebond eangle edihed eimp evdwl ecoul elong temp vol pxx pyy pzz
dump            1 all atom ${dcdfreq} ${outputname}.lammpstrj


#min_style       cg
#minimize        0.0 1.0e-8 10000 20000
#write_data      ${outputname}_minimize.data

#reset_timestep  0

run             25000000
#run              1000
write_dump      all custom ${outputname}.dump id type x y z vx vy vz ix iy iz
write_data      ${outputname}.data
